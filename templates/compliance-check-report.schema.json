{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mm-ai/templates/compliance-check-report.schema.json",
  "title": "MM-AI Compliance Check Report",
  "type": "object",
  "required": [
    "project",
    "assessment_scope",
    "date",
    "rules"
  ],
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "assessment_scope": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "gate_recommendation": { "type": "string", "enum": ["Pass", "Conditional Pass", "Fail"] },
    "blocking_conditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "result", "weight", "severity"],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "result": { "type": "number", "enum": [0, 0.5, 1] },
          "weight": { "type": "number", "minimum": 0 },
          "severity": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
          "notes": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
